# EK Bot configuration
# The bot's @username is fetched live from the Telegram API on startup.

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:your-telegram-bot-token-from-botfather

# Optional: Google Gemini Pro API key for OCR text extraction
# Get free at: https://aistudio.google.com/apikey
# If not set, the bot still sends the cleaned image — just no text extraction
GEMINI_API_KEY=your-gemini-api-key-here
